{
  "name": "session-manager",
  "version": "0.1.5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run lint:firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "icons": "node scripts/icons.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "0.3.0",
    "eslint": "10.11.0",
    "puppeteer-core": "25.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "web-ext": "10.7.0"
  }
}
